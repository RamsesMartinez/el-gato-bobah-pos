# Reemplaza el dominio por el real en producción. Caddy gestiona TLS automáticamente.
pos.elgatobobah.mx {
	# Headers de seguridad (subset seguro que no rompe la SPA).
	header {
		# HSTS: fuerza HTTPS en el navegador (1 año, subdominios).
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# No adivinar el MIME type.
		X-Content-Type-Options "nosniff"
		# Anti-clickjacking (X-Frame-Options para navegadores viejos; frame-ancestors abajo
		# es el equivalente moderno).
		X-Frame-Options "DENY"
		# CSP completo, probado contra el build real de la SPA (headless Chrome, 0 violaciones):
		#  - script-src 'self': el bundle de Vite es un módulo externo, sin scripts inline.
		#  - style-src 'unsafe-inline': Chakra/Emotion inyectan estilos inline en runtime.
		#  - img-src data:: por si Chakra/Vite incrustan algún asset chico como data URI.
		#  - connect-src 'self': API y SSE son del mismo origen (Caddy hace proxy de /api).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		# No filtrar URLs (incluye el ?token= del SSE) vía Referer.
		Referrer-Policy "no-referrer"
		# No revelar el servidor.
		-Server
	}

	handle /api/* {
		reverse_proxy api:8080 {
			flush_interval -1  # streaming inmediato para SSE
		}
	}
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
	encode gzip
}
