# Solo API: el frontend ahora vive en Cloudflare Pages (su propio dominio/CSP, ver
# web/public/_headers). Reemplaza el dominio por el real si cambia. TLS automático.
api.elgatobobah.com {
	# Headers de seguridad (subset razonable para una API JSON, no una SPA).
	header {
		# HSTS: fuerza HTTPS en el navegador (1 año, subdominios).
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# No adivinar el MIME type.
		X-Content-Type-Options "nosniff"
		# Anti-clickjacking (no debería renderizarse en un frame de todos modos).
		X-Frame-Options "DENY"
		# La API no sirve HTML: sin ejecutables ni framing posible.
		Content-Security-Policy "default-src 'none'"
		# No filtrar URLs (incluye el ?token= del SSE) vía Referer.
		Referrer-Policy "no-referrer"
		# No revelar el servidor.
		-Server
	}

	reverse_proxy api:8080 {
		flush_interval -1  # streaming inmediato para SSE
	}
	encode gzip
}
