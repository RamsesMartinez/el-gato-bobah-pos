# Copia a deploy/.env y completa. deploy/.env está gitignored.
# Genera secretos fuertes:  openssl rand -base64 48  (JWT)  ·  openssl rand -hex 24  (DB)

# Nombre de la base y del rol owner (migra/bootstrap). Opcionales — docker-compose.yml cae en
# "gatobobah" si no se definen; están aquí para no tener el nombre hardcodeado en el compose.
POSTGRES_DB=gatobobah
POSTGRES_USER=gatobobah
POSTGRES_PASSWORD=cambia-esto
JWT_SECRET=cambia-esto-por-un-secreto-largo-aleatorio-de-32-o-mas

# PIN_PEPPER: secreto con el que se calcula la huella de cada PIN (openssl rand -base64 48).
# OPCIONAL. Vacío = el negocio funciona normal (se elige a la persona y luego se teclea el PIN);
# lo único que NO se puede encender es el modo de desbloqueo con solo el PIN, porque sin este
# secreto no hay forma de garantizar que dos personas no compartan PIN y el ajuste se niega a
# activarse.
# NO LO ROTES con el modo encendido: cambiarlo invalida todas las huellas guardadas y nadie
# vuelve a desbloquear con su PIN hasta recapturarlo. Rotarlo = apagar el modo, cambiar el
# secreto, volver a encenderlo (eso borra los PINs y obliga a recapturarlos).
PIN_PEPPER=
LOG_LEVEL=info
# En producción define los orígenes EXACTOS (esquema+host), separados por coma. NUNCA "*" en
# prod —ni siquiera como una entrada más de la lista—: la API se niega a arrancar. Vacío = solo
# mismo origen. Van dos porque son dos frentes contra la misma API: el POS y la consola de
# plataforma, cada uno en su subdominio.
CORS_ORIGIN=https://app.elgatobobah.com,https://staff.elgatobobah.com

# Rol de aplicación (RLS multi-empresa): la API sirve como gatobobah_app (no-superusuario) para
# que Postgres aísle los datos por empresa. Password propio (openssl rand -hex 24). El bootstrap
# se lo fija al rol al arrancar. En dev puede omitirse (la API sirve como owner, single-tenant).
APP_DB_PASSWORD=cambia-esto-otro-secreto

# --- Consola de plataforma (spec 016). LAS DOS SON OBLIGATORIAS: sin ellas la API no arranca. ---
# PLATFORM_JWT_SECRET firma las sesiones de la consola y tiene que ser DISTINTO de JWT_SECRET
# (openssl rand -base64 48). Si fueran iguales, un token del negocio valdría en la consola y al
# revés — nada se rompería, solo dejaría de separar, que es peor.
PLATFORM_JWT_SECRET=cambia-esto-por-otro-secreto-largo-aleatorio-de-32-o-mas
# Password del rol gatobobah_platform (openssl rand -hex 24), que solo puede LEER companies y las
# tablas de plataforma. El bootstrap se lo fija al arrancar, igual que con el rol de la aplicación.
PLATFORM_DB_PASSWORD=cambia-esto-otro-secreto-mas

# Empresa inicial (tenant por defecto). El slug forma el login username@slug y es editable
# luego por el admin de la empresa desde el panel.
COMPANY_SLUG=gatobobah
COMPANY_NAME=El Gato Bobah

# Admin inicial (se crea solo si la tabla users está vacía), dentro de COMPANY_SLUG.
# ADMIN_PIN: evita 1234/0000/secuencias — la API rechaza PINs triviales.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esto
ADMIN_PIN=cambia-esto

# --- Email (recuperación de contraseña). Prod = Zoho Mail SMTP. Vacío SMTP_HOST = deshabilitado. ---
# Zoho: host smtp.zoho.com (o .eu/.in según tu región), puerto 465 (SSL) o 587 (STARTTLS).
# SMTP_USER = tu buzón Zoho completo; SMTP_PASS = una "App Password" de Zoho (no la del login).
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=no-reply@tudominio.com
SMTP_PASS=cambia-esto-app-password-de-zoho
MAIL_FROM=no-reply@tudominio.com
# Origen público del frontend, para armar el link del correo de recuperación.
APP_BASE_URL=https://app.elgatobobah.com

# HIBP: verifica contraseñas contra brechas conocidas (k-anonymity) al fijarlas. Fail-open.
HIBP_ENABLED=true

# --- Extracción de tickets/facturas de compra (Anthropic API) ---
# OPCIONAL: vacío = las líneas del gasto se capturan a mano. El POS opera sin esto (y sin
# internet); la extracción solo prellena el borrador, que el operador siempre confirma.
# La API se niega a arrancar si la llave no empieza con sk-ant- (evita un 401 opaco en la
# primera compra). Verifica la extracción con: make parse-docs
ANTHROPIC_API_KEY=
# Modelo de extracción. Se puede cambiar sin recompilar para ajustar costo/calidad; la llamada
# no manda thinking ni effort, así que cualquier modelo del catálogo es válido.
ANTHROPIC_MODEL=claude-opus-5
