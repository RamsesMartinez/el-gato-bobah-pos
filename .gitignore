# dependencies
node_modules/
.pnp
.pnp.js

# builds
web/dist/
# El build de la consola de plataforma va a su propio directorio para no borrar el del POS.
web/dist-consola/
/build

# frontend
web/*.local

# backend Go (F1)
server/tmp/
server/api

# testing
/coverage

# env / secrets
.env
.env.local
.env.*.local
deploy/.env

# editor / os
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# logs con rotación
logs/
server/logs/
docs/tickets/*
!docs/tickets/.gitkeep

# Respaldos de producción: datos reales del negocio, nunca se versionan (ver backups/README.md).
backups/prod/*
!backups/prod/.gitkeep

# Salidas de Playwright: trazas, capturas y el reporte de una corrida. Se regeneran.
web/test-results/
web/playwright-report/
# Marca del teardown de Playwright: qué pedidos ya estaban abiertos al empezar la suite.
web/.playwright-abiertos.json

# Permisos locales de Claude Code: dan SSH a las VPS y son de esta máquina.
# El repo es público y la sesión de gcloud es personal — no se comparte.
.claude/settings.local.json

# Respaldo de producción bajado por scripts/respaldo-anonimo.sh (trae datos del negocio).
.respaldo-produccion.sql.gz

# DATOS DEL NEGOCIO — nunca en el repositorio.
#
# `references/` traía los exports reales de FUDO: costo de compra de cada insumo, nombre de cada
# proveedor, ventas por día y por hora, y gastos por categoría incluyendo pago a colaboradores.
# Estuvo público desde el 2026-07-16. Es la estructura de márgenes del negocio, y este repositorio
# es público y puede volverse open source.
#
# Dónde vive ahora: `~/gatobobah-datos/references/` en la máquina del dueño. `make fudo-import`
# lo lee de ahí — ver AGENTS.md §1.
references/

# Credenciales de la extensión REST Client (`http/*.http`): trae el Client Secret de Uber.
# La plantilla sin secretos sí se commitea: `.vscode/settings.json.example`.
.vscode/settings.json
