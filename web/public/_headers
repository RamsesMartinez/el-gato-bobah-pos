# Cloudflare Pages headers (sintaxis propia, no un Caddyfile). Antes vivían en deploy/Caddyfile,
# pero el frontend ya no lo sirve Caddy — ahora Cloudflare Pages. connect-src debe listar el
# dominio de la API explícitamente: ya no es mismo-origen.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://api.elgatobobah.com; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Referrer-Policy: no-referrer
